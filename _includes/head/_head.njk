<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title or "Hudson Stingers Robotics"}}</title>
  
    <!-- PNG favicon (96px is a multiple of 48, which Google Search requires) -->
    <link rel="icon" type="image/png" sizes="96x96" href="/images/icon/favicon-96x96.png">
  
    <!-- Legacy ICO fallback -->
    <link rel="shortcut icon" href="/favicon.ico">
  
    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icon/apple-touch-icon.png">
  
    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest">
  
    <!-- Font Awesome Free, self-hosted (built by .eleventy.js from the npm package) -->
    <link rel="stylesheet" href="/styles/fontawesome.css">

    <!-- Custom Font, preloaded because every page title uses it -->
    <link rel="preload" href="/fonts/husdonstinger.woff2" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face {
        font-family: 'Hudson Stinger';
        src: url('/fonts/husdonstinger.woff2') format('woff2'),
             url('/fonts/husdonstinger.otf') format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        /* The font only draws letters and digits (its punctuation is blank), so "&", "?"
           and the like fall back to the normal font. */
        unicode-range: U+0020, U+0030-0039, U+0041-005A, U+0061-007A;
      }
    </style>

    <script data-goatcounter="https://juanbarron.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  
    {% block headMeta %}{% endblock %}

    <!-- Tailwind, compiled at build time (see tailwind.config.js). Linked last so it
         keeps the cascade position the CDN's injected <style> had. -->
    <link rel="stylesheet" href="/styles/tailwind.css">
  </head>